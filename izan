		TextXAlignment = Enum.TextXAlignment.Left,
	}) :: TextBox
	corner(6).Parent = box
	padding(0, 9, 0, 9).Parent = box
	self.App:_theme(box, "BackgroundColor3", "Surface")
	self.App:_theme(box, "TextColor3", "Text")
	box.Parent = row
