function Section:AddKeybind(options: any)
	options = options or {}
	if options.Default == nil then options.Default = Enum.KeyCode.Unknown end
	local row, hit, title = self:_row(options)
	title.Size = UDim2.new(1, -125, 0, options.Description and 22 or 48)
	local keyButton = self.App:_button("Не назначено")
	keyButton.AnchorPoint = Vector2.new(1, 0.5)
	keyButton.Position = UDim2.new(1, -10, 0.5, 0)
	keyButton.Size = UDim2.fromOffset(106, 30)
	keyButton.Parent = row
	hit.Active = false
	local listening = false
	local element = self.App:_registerElement(setmetatable({
		Container = row,
		Interactive = keyButton,
	}, Element), options)
	function element:SetValue(value: any, silent: boolean?)
		local key = value
		if typeof(key) == "string" then key = Enum.KeyCode[key] end
		if typeof(key) ~= "EnumItem" or key.EnumType ~= Enum.KeyCode then key = Enum.KeyCode.Unknown end
		keyButton.Text = key == Enum.KeyCode.Unknown and "Не назначено" or key.Name
		self:_emit(key, silent)
	end
	keyButton.Activated:Connect(function()
		if element.Disabled then return end
		listening = true
		keyButton.Text = "Нажмите…"
	end)
	table.insert(self.App._connections, UserInputService.InputBegan:Connect(function(input, processed)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				element:SetValue(input.KeyCode)
			end
			return
		end
		if not processed and not element.Disabled and element.Value ~= Enum.KeyCode.Unknown and input.KeyCode == element.Value then
			if type(options.OnPressed) == "function" then task.spawn(options.OnPressed, element.Value, element) end
		end
	end))
	element:SetValue(options.Default, true)
	element:_refreshCondition()
	return element
end

