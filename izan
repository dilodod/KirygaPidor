function Section:AddSlider(options: any)
	options = options or {}
	local minimum = tonumber(options.Min) or 0
	local maximum = tonumber(options.Max) or 100
	if maximum <= minimum then maximum = minimum + 1 end
	local step = tonumber(options.Step) or 1
	if options.Default == nil then options.Default = minimum end
	local row, _, title = self:_row(options, options.Description and 70 or 62)
	title.Size = UDim2.new(1, -80, 0, 26)
	local valueLabel = self.App:_text("", 12, "Accent")
	valueLabel.AnchorPoint = Vector2.new(1, 0)
	valueLabel.Position = UDim2.new(1, -12, 0, 5)
	valueLabel.Size = UDim2.fromOffset(70, 22)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Parent = row
	local bar = create("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = self.App.Theme.Border,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 12, 1, -18),
		Size = UDim2.new(1, -24, 0, 5),
		Text = "",
	}) :: TextButton
	corner(3).Parent = bar
	self.App:_theme(bar, "BackgroundColor3", "Border")
	local fill = create("Frame", {
		BackgroundColor3 = self.App.Theme.Accent,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 0, 1, 0),
	}) :: Frame
	corner(3).Parent = fill
	self.App:_theme(fill, "BackgroundColor3", "Accent")
	fill.Parent = bar
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = self.App.Theme.Text,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
	}) :: Frame
	corner(6).Parent = knob
	self.App:_theme(knob, "BackgroundColor3", "Text")
	knob.Parent = bar
	bar.Parent = row
	local element = self.App:_registerElement(setmetatable({
		Container = row,
		Interactive = bar,
		Min = minimum,
		Max = maximum,
		Step = step,
	}, Element), options)
	function element:SetValue(value: any, silent: boolean?)
		local numberValue = roundToStep(clampNumber(value, minimum, maximum, minimum), step)
		numberValue = math.clamp(numberValue, minimum, maximum)
		local alpha = (numberValue - minimum) / (maximum - minimum)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		valueLabel.Text = tostring(numberValue) .. tostring(options.Suffix or "")
		self:_emit(numberValue, silent)
	end
	local dragging = false
	local function update(input: InputObject)
		local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		element:SetValue(minimum + (maximum - minimum) * alpha)
	end
	bar.InputBegan:Connect(function(input)
		if element.Disabled then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input)
		end
	end)
	table.insert(self.App._connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end))
	table.insert(self.App._connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
	element:SetValue(options.Default, true)
	element:_refreshCondition()
	return element
end

function Section:AddDropdown(options: any)
	options = options or {}
	local items = options.Options or {}
	local multi = options.Multi == true
	if options.Default == nil then options.Default = multi and {} or nil end
	local row, hit, title = self:_row(options)
	title.Size = UDim2.new(0.47, -12, 0, options.Description and 22 or 48)
	local selected = self.App:_button("Выбрать")
	selected.AnchorPoint = Vector2.new(1, 0.5)
	selected.Position = UDim2.new(1, -10, 0.5, 0)
	selected.Size = UDim2.new(0.48, 0, 0, 30)
	selected.TextXAlignment = Enum.TextXAlignment.Left
	padding(0, 9, 0, 9).Parent = selected
	selected.Parent = row
	hit.Active = false
	local element = self.App:_registerElement(setmetatable({
		Container = row,
		Interactive = selected,
		Options = items,
		Multi = multi,
	}, Element), options)

	local popup: Frame? = nil
	local function displayValue(value: any)
		if multi and type(value) == "table" then
			selected.Text = #value > 0 and table.concat(value, ", ") or "Выбрать"
		else
			selected.Text = value ~= nil and tostring(value) or "Выбрать"
		end
	end
	function element:SetValue(value: any, silent: boolean?)
		if multi then
			local result = {}
			local seen = {}
			if type(value) == "table" then
				for _, item in ipairs(value) do
					local stringItem = tostring(item)
					if table.find(self.Options, stringItem) and not seen[stringItem] then
						seen[stringItem] = true
						table.insert(result, stringItem)
					end
				end
			end
			value = result
		elseif value ~= nil then
			value = tostring(value)
			if not table.find(self.Options, value) then value = nil end
		end
		displayValue(value)
		self:_emit(value, silent)
	end
	function element:SetOptions(nextOptions: {string})
		self.Options = nextOptions
		if popup then popup:Destroy(); popup = nil end
		self:SetValue(self.Value, true)
	end
	local function closePopup()
		if popup then
			popup:Destroy()
			popup = nil
		end
	end
	selected.Activated:Connect(function()
		if element.Disabled then return end
		if popup then closePopup(); return end
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
		local popupWidth = math.min(math.max(220, selected.AbsoluteSize.X), viewport.X - 16)
		local popupHeight = math.min(224, viewport.Y - 16)
		local popupX = math.clamp(selected.AbsolutePosition.X, 8, math.max(8, viewport.X - popupWidth - 8))
		local belowY = selected.AbsolutePosition.Y + selected.AbsoluteSize.Y + 5
		local popupY = if belowY + popupHeight <= viewport.Y - 8
			then belowY
			else math.max(8, selected.AbsolutePosition.Y - popupHeight - 5)
		popup = create("Frame", {
			BackgroundColor3 = self.App.Theme.Surface,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(popupX, popupY),
			Size = UDim2.fromOffset(popupWidth, popupHeight),
			ZIndex = 40,
		}) :: Frame
		corner(8).Parent = popup
		local popStroke = stroke(self.App.Theme.Border)
		popStroke.Parent = popup
		self.App:_theme(popup, "BackgroundColor3", "Surface")
		self.App:_theme(popStroke, "Color", "Border")
		local search = create("TextBox", {
			BackgroundColor3 = self.App.Theme.SurfaceAlt,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = Enum.Font.Gotham,
			PlaceholderText = "Поиск…",
			PlaceholderColor3 = self.App.Theme.MutedText,
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.new(1, -16, 0, 32),
			Text = "",
			TextColor3 = self.App.Theme.Text,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 41,
		}) :: TextBox
		corner(6).Parent = search
		padding(0, 10, 0, 10).Parent = search
		search.Parent = popup
		local list = create("ScrollingFrame", {
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
