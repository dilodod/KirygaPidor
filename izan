function App:_theme(instance: Instance, property: string, token: string)
	table.insert(self._themed, {Instance = instance, Property = property, Token = token})
	local dynamicInstance = instance :: any
	dynamicInstance[property] = self.Theme[token]
end

function App:_applyTheme()
	for index = #self._themed, 1, -1 do
		local binding = self._themed[index]
		if binding.Instance.Parent then
			local dynamicInstance = binding.Instance :: any
			dynamicInstance[binding.Property] = self.Theme[binding.Token]
		else
			table.remove(self._themed, index)
		end
	end
end

function App:SetTheme(nameOrTheme: any)
	local nextTheme
	local themeName = self.ThemeName
	if type(nameOrTheme) == "string" and THEMES[nameOrTheme] then
		nextTheme = THEMES[nameOrTheme]
		themeName = nameOrTheme
	elseif type(nameOrTheme) == "table" then
		nextTheme = table.clone(self.Theme)
		for token, color in pairs(nameOrTheme) do
			if typeof(color) == "Color3" and nextTheme[token] ~= nil then
				nextTheme[token] = color
			end
		end
		themeName = "Custom"
	end
	if not nextTheme then
		return false
	end
	self.Theme = nextTheme
	self.ThemeName = themeName
	self:_applyTheme()
	self:_scheduleSave()
	return true
end

function App:GetThemeNames()
	local names = {}
	for name in pairs(THEMES) do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

function App:_text(text: string, size: number, colorToken: string?): TextLabel
	local label = create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = text,
		TextColor3 = self.Theme[colorToken or "Text"],
		TextSize = size,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}) :: TextLabel
	self:_theme(label, "TextColor3", colorToken or "Text")
	return label
end

function App:_button(text: string): TextButton
	local button = create("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = self.Theme.SurfaceAlt,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamMedium,
		Text = text,
		TextColor3 = self.Theme.Text,
		TextSize = 13,
	}) :: TextButton
	corner(7).Parent = button
	local border = stroke(self.Theme.Border, 0.25)
	border.Parent = button
	self:_theme(button, "BackgroundColor3", "SurfaceAlt")
	self:_theme(button, "TextColor3", "Text")
	self:_theme(border, "Color", "Border")
	button.MouseEnter:Connect(function()
		if button.Active then
			tween(button, {BackgroundColor3 = self.Theme.SurfaceHover}, 0.14)
		end
	end)
	button.MouseLeave:Connect(function()
		tween(button, {BackgroundColor3 = self.Theme.SurfaceAlt}, 0.14)
	end)
	return button
end

function App:_setTooltip(target: GuiObject, text: string?)
	if not text or text == "" then
		return
	end
	target.MouseEnter:Connect(function()
		self.TooltipLabel.Text = text
		local bounds = TextService:GetTextSize(text, 12, Enum.Font.Gotham, Vector2.new(280, 1000))
		self.Tooltip.Size = UDim2.fromOffset(math.min(296, bounds.X + 20), bounds.Y + 16)
		self.Tooltip.Visible = true
	end)
	target.MouseLeave:Connect(function()
		self.Tooltip.Visible = false
	end)
end

function App:_registerElement(element: any, options: any)
	local id = options.Id
	if type(id) ~= "string" or id == "" then
		id = HttpService:GenerateGUID(false)
	end
	if self.Elements[id] then
		error(("KirygaUaTop: duplicate element Id '%s'"):format(id), 3)
	end
	element.Id = id
	element.App = self
	element.Callback = options.Callback
	element.DisabledCondition = options.Disabled
	element.VisibleCondition = options.Visible
	element.Default = options.Default
	element.Value = options.Default
	self.Elements[id] = element
	if options.Default ~= nil then
		self.Values[id] = options.Default
	end
	table.insert(self._conditions, element)
	return element
end

function Element:_emit(value: any, silent: boolean?)
	self.Value = value
	self.App.Values[self.Id] = value
	if not silent and type(self.Callback) == "function" then
		task.spawn(function()
			local ok, message = pcall(self.Callback, value, self)
			if not ok then
				self.App:Notify({
					Title = "Ошибка callback",
					Content = tostring(message),
					Type = "Error",
				})
			end
		end)
	end
	self.App:_scheduleSave()
end

function Element:SetDisabled(disabled: boolean)
	self.DisabledCondition = disabled
	self:_refreshCondition()
end

function Element:SetVisible(visible: boolean)
	self.VisibleCondition = visible
	self:_refreshCondition()
end

function Element:_refreshCondition()
	local disabled = conditionValue(self.DisabledCondition, false)
	local visible = conditionValue(self.VisibleCondition, true)
	self.Disabled = disabled
	self.Container.Visible = visible
	self.Container.Active = not disabled
	if self.Interactive then
		self.Interactive.Active = not disabled
		self.Interactive.Selectable = not disabled
	end
	self.Container.GroupTransparency = disabled and 0.48 or 0
end

function Element:GetValue()
	return self.Value
end

function App:GetValue(id: string)
	return self.Values[id]
end

function App:SetValue(id: string, value: any, silent: boolean?)
	local element = self.Elements[id]
	if not element or type(element.SetValue) ~= "function" then
		return false
	end
	element:SetValue(value, silent)
	return true
end

function App:SetHotkey(keyCode: Enum.KeyCode)
	if typeof(keyCode) == "EnumItem" and keyCode.EnumType == Enum.KeyCode then
		self.Hotkey = keyCode
		self:_scheduleSave()
	end
end

function App:SetOpen(open: boolean)
	self.Open = open
	if open then
		self.ScreenGui.Enabled = true
		self.Main.Visible = true
		self.Main.GroupTransparency = 1
		self.Main.Size = UDim2.fromOffset(
			math.max(360, self.Main.AbsoluteSize.X - 10),
			math.max(320, self.Main.AbsoluteSize.Y - 10)
		)
		tween(self.Main, {
			GroupTransparency = 0,
			Size = self.TargetSize,
		}, 0.2)
	else
		tween(self.Main, {GroupTransparency = 1}, 0.16)
		task.delay(0.17, function()
			if not self.Open and self.ScreenGui.Parent then
				self.ScreenGui.Enabled = false
			end
		end)
	end
end

function App:Toggle()
	self:SetOpen(not self.Open)
end

function App:Destroy()
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	self.ScreenGui:Destroy()
end

function App:_windowState()
	return {
		position = serializable(self.Main.Position),
		size = serializable(self.TargetSize),
	}
end

function App:_snapshot()
	local values = {}
	for id, value in pairs(self.Values) do
		values[id] = serializable(value)
	end
	return {
		version = 1,
		theme = self.ThemeName,
		hotkey = serializable(self.Hotkey),
		values = values,
		window = self:_windowState(),
	}
end

function App:_applySnapshot(snapshot: any, silent: boolean?)
	if type(snapshot) ~= "table" then
		return false, "Некорректная структура конфига"
	end
	if type(snapshot.theme) == "string" then
		self:SetTheme(snapshot.theme)
	end
	local key = deserialize(snapshot.hotkey)
	if typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode then
		self.Hotkey = key
	end
	if type(snapshot.window) == "table" then
		local position = deserialize(snapshot.window.position)
		local size = deserialize(snapshot.window.size)
		if typeof(position) == "UDim2" then
			self.Main.Position = position
		end
		if typeof(size) == "UDim2" then
			self.TargetSize = UDim2.fromOffset(
				math.clamp(size.X.Offset, self.MinSize.X, self.MaxSize.X),
				math.clamp(size.Y.Offset, self.MinSize.Y, self.MaxSize.Y)
			)
			self.Main.Size = self.TargetSize
		end
	end
	if type(snapshot.values) == "table" then
		for id, stored in pairs(snapshot.values) do
			self:SetValue(id, deserialize(stored), silent)
		end
	end
	return true
end

function App:ExportConfig(): string
	return HttpService:JSONEncode(self:_snapshot())
end

function App:ImportConfig(json: string, silent: boolean?)
	if type(json) ~= "string" or #json > 100000 then
		return false, "Конфиг слишком большой или имеет неверный тип"
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, json)
	if not ok then
		return false, "Не удалось прочитать JSON"
	end
	return self:_applySnapshot(decoded, silent)
end

function App:_adapterCall(method: string, ...)
	local member = self.ConfigAdapter and self.ConfigAdapter[method]
	if type(member) ~= "function" then
		return false, ("Адаптер не поддерживает %s"):format(method)
	end
	local result = table.pack(pcall(member, self.ConfigAdapter, ...))
	if not result[1] then
		return false, tostring(result[2])
	end
	return table.unpack(result, 2, result.n)
end

local function cleanProfileName(name: any): string?
	if type(name) ~= "string" then
		return nil
	end
	local clean = name:match("^%s*(.-)%s*$")
	if #clean < 1 or #clean > 32 or not clean:match("^[%w_%-%sА-Яа-яЁёІіЇїЄє]+$") then
		return nil
	end
	return clean
end

function App:CreateProfile(name: string)
	local clean = cleanProfileName(name)
	if not clean then
		return false, "Имя: 1–32 символа, буквы, цифры, пробел, _ или -"
	end
	local ok, message = self:_adapterCall("Save", clean, self:_snapshot())
	if ok ~= false then
		self.CurrentProfile = clean
		self:_refreshProfileControls()
		return true
	end
	return false, message
end

function App:SaveProfile(name: string?)
	local clean = cleanProfileName(name or self.CurrentProfile)
	if not clean then
		return false, "Сначала выберите или создайте профиль"
	end
	local ok, message = self:_adapterCall("Save", clean, self:_snapshot())
	if ok ~= false then
		self.CurrentProfile = clean
		return true
	end
	return false, message
end

function App:LoadProfile(name: string)
	local clean = cleanProfileName(name)
	if not clean then
		return false, "Некорректное имя профиля"
	end
	local data, message = self:_adapterCall("Load", clean)
	if data == false or data == nil then
		return false, message or "Профиль не найден"
	end
	local ok, applyMessage = self:_applySnapshot(data, false)
	if ok then
		self.CurrentProfile = clean
	end
	return ok, applyMessage
end

function App:DeleteProfile(name: string)
	local clean = cleanProfileName(name)
	if not clean then
		return false, "Некорректное имя профиля"
	end
	local ok, message = self:_adapterCall("Delete", clean)
	if ok ~= false and self.CurrentProfile == clean then
		self.CurrentProfile = nil
	end
	self:_refreshProfileControls()
	return ok ~= false, message
end

function App:CopyProfile(source: string, target: string)
	local cleanSource = cleanProfileName(source)
	local cleanTarget = cleanProfileName(target)
	if not cleanSource or not cleanTarget then
		return false, "Проверьте имена профилей"
	end
	local ok, message = self:_adapterCall("Copy", cleanSource, cleanTarget)
	self:_refreshProfileControls()
	return ok ~= false, message
end

function App:ListProfiles()
	local result = self:_adapterCall("List")
	return type(result) == "table" and result or {}
end

function App:SetAutoLoad(name: string?)
	local clean = name and cleanProfileName(name) or nil
	if name and not clean then
		return false, "Некорректное имя профиля"
	end
	local ok, message = self:_adapterCall("SetAutoLoad", clean)
	if ok ~= false then
		self.AutoLoadProfile = clean
		return true
	end
	return false, message
end

function App:TryAutoLoad()
	local name = self:_adapterCall("GetAutoLoad")
	if type(name) == "string" and name ~= "" then
		self.AutoLoadProfile = name
		return self:LoadProfile(name)
	end
	return false, "Автозагрузка не настроена"
end

function App:Reset()
	for _, element in pairs(self.Elements) do
		if element.Default ~= nil and type(element.SetValue) == "function" then
			element:SetValue(element.Default, false)
		end
	end
	self:SetTheme(self.DefaultTheme)
	self.Hotkey = self.DefaultHotkey
	self.Main.Position = UDim2.fromScale(0.5, 0.5)
	self.TargetSize = self.DefaultSize
	self.Main.Size = self.TargetSize
end

function App:_scheduleSave()
	if not self.AutoSave or not self.CurrentProfile or self._saveScheduled then
		return
	end
	self._saveScheduled = true
	task.delay(0.8, function()
		self._saveScheduled = false
		if self.ScreenGui.Parent and self.CurrentProfile then
			self:SaveProfile()
		end
	end)
end

function App:SetNotificationsEnabled(enabled: boolean)
	self.NotificationsEnabled = enabled == true
	if not self.NotificationsEnabled and self.NotificationHolder then
		for _, child in ipairs(self.NotificationHolder:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end
	self:_scheduleSave()
end

function App:Notify(options: any)
	options = options or {}
	if not self.NotificationsEnabled and options.Force ~= true then
		return nil
	end
	local typeName = options.Type or "Info"
	local accentToken = if typeName == "Error" then "Danger" elseif typeName == "Success" then "Success" else "Accent"
	local duration = clampNumber(options.Duration, 1, 10, 3.2)
	self._notificationSequence += 1
	local existing = {}
	for _, child in ipairs(self.NotificationHolder:GetChildren()) do
		if child:IsA("GuiObject") and child.Name == "NotificationCard" then
			table.insert(existing, child)
		end
	end
	table.sort(existing, function(left, right)
		return left.LayoutOrder < right.LayoutOrder
	end)
	while #existing >= 3 do
		existing[1]:Destroy()
		table.remove(existing, 1)
	end
	local card = create("CanvasGroup", {
		BackgroundColor3 = self.Theme.Surface,
		BorderSizePixel = 0,
		LayoutOrder = self._notificationSequence,
		Name = "NotificationCard",
		Position = UDim2.new(1, 18, 0, 0),
		Size = UDim2.new(1, 0, 0, 56),
		ZIndex = 71,
	}) :: CanvasGroup
	corner(7).Parent = card
	local cardStroke = stroke(self.Theme.Border, 0.45)
	cardStroke.Parent = card
	self:_theme(card, "BackgroundColor3", "Surface")
	self:_theme(cardStroke, "Color", "Border")

	local accent = create("Frame", {
		BackgroundColor3 = self.Theme[accentToken],
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(7, 8),
		Size = UDim2.new(0, 2, 1, -16),
		ZIndex = 72,
	}) :: Frame
	corner(1).Parent = accent
	self:_theme(accent, "BackgroundColor3", accentToken)
	accent.Parent = card

	local title = self:_text(tostring(options.Title or "KirygaUaTop"), 12)
	title.Font = Enum.Font.GothamSemibold
