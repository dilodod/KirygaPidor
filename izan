function App:_showTab(tab: any)
	for _, candidate in ipairs(self.Tabs) do
		local selected = candidate == tab
		candidate.Page.Visible = selected
		tween(candidate.Button, {
			BackgroundTransparency = selected and 0 or 1,
			TextColor3 = selected and self.Theme.Text or self.Theme.MutedText,
		}, 0.15)
		candidate.Indicator.Visible = selected
	end
	self.ActiveTab = tab
	if self.Mobile then
		self.Sidebar.Visible = false
	end
end

