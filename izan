	}) :: Frame
	topbar.Parent = main
	local brand = self:_text(self.Name, 16)
	brand.Font = Enum.Font.GothamSemibold
	brand.Position = UDim2.fromOffset(18, 0)
	brand.Size = UDim2.new(1, -106, 1, 0)
	brand.Parent = topbar
	local subtitle = self:_text("KIRYGA UI", 9, "Accent")
	subtitle.Font = Enum.Font.GothamBold
	subtitle.Position = UDim2.fromOffset(18, 33)
	subtitle.Size = UDim2.fromOffset(110, 14)
	subtitle.Parent = topbar
	local headerButtonSize = self.Mobile and 40 or 30
	local close = self:_button("×")
	close.AnchorPoint = Vector2.new(1, 0.5)
	close.Position = UDim2.new(1, -14, 0.5, 0)
	close.Size = UDim2.fromOffset(headerButtonSize, headerButtonSize)
	close.TextSize = 18
	close.Parent = topbar
	close.Activated:Connect(function() self:SetOpen(false) end)
	local menu = self:_button("☰")
	menu.AnchorPoint = Vector2.new(1, 0.5)
	menu.Position = UDim2.new(1, -(20 + headerButtonSize), 0.5, 0)
	menu.Size = UDim2.fromOffset(headerButtonSize, headerButtonSize)
	menu.Visible = self.Mobile
	menu.Parent = topbar

	local divider = create("Frame", {
		BackgroundColor3 = self.Theme.Border,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 1),
	}) :: Frame
	self:_theme(divider, "BackgroundColor3", "Border")
	divider.Parent = main

	local sidebarWidth = self.Mobile and 200 or 188
	local sidebar = create("Frame", {
		BackgroundColor3 = self.Theme.Surface,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 55),
		Size = UDim2.new(0, sidebarWidth, 1, -55),
		ZIndex = self.Mobile and 10 or 1,
	}) :: Frame
	self:_theme(sidebar, "BackgroundColor3", "Surface")
	sidebar.Parent = main
	self.Sidebar = sidebar
	local tabButtons = create("ScrollingFrame", {
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		Position = UDim2.fromOffset(10, 12),
		ScrollBarThickness = 0,
		Size = UDim2.new(1, -20, 1, -24),
	}) :: ScrollingFrame
	create("UIListLayout", {Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder}).Parent = tabButtons
	tabButtons.Parent = sidebar
	self.TabButtons = tabButtons

	local content = create("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(self.Mobile and 0 or sidebarWidth, 55),
		Size = UDim2.new(1, self.Mobile and 0 or -sidebarWidth, 1, -55),
	}) :: Frame
	content.Parent = main
	self.Content = content
	if self.Mobile then sidebar.Visible = false end
	menu.Activated:Connect(function() sidebar.Visible = not sidebar.Visible end)

	local resize = create("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(28, 28),
		Text = "◢",
		TextColor3 = self.Theme.MutedText,
		TextSize = 13,
		ZIndex = 20,
	}) :: TextButton
	self:_theme(resize, "TextColor3", "MutedText")
	resize.Visible = not self.Mobile
	resize.Parent = main

	local notifications = create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Name = "Notifications",
		Position = UDim2.new(1, -12, 0, 64),
		Size = UDim2.fromOffset(self.Mobile and 218 or 260, 0),
		ZIndex = 70,
	}) :: Frame
	create("UIListLayout", {
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}).Parent = notifications
	notifications.Parent = screenGui
	self.NotificationHolder = notifications

	local tooltip = create("Frame", {
		BackgroundColor3 = self.Theme.Surface,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(200, 32),
		Visible = false,
		ZIndex = 80,
	}) :: Frame
	corner(6).Parent = tooltip
	local tooltipStroke = stroke(self.Theme.Border)
	tooltipStroke.Parent = tooltip
	self:_theme(tooltip, "BackgroundColor3", "Surface")
	self:_theme(tooltipStroke, "Color", "Border")
	local tooltipLabel = self:_text("", 12)
	tooltipLabel.Position = UDim2.fromOffset(10, 8)
	tooltipLabel.Size = UDim2.new(1, -20, 1, -16)
	tooltipLabel.TextWrapped = true
	tooltipLabel.TextYAlignment = Enum.TextYAlignment.Top
	tooltipLabel.ZIndex = 81
	tooltipLabel.Parent = tooltip
	tooltip.Parent = screenGui
	self.Tooltip = tooltip
	self.TooltipLabel = tooltipLabel

	local dragging = false
	local dragStart = Vector2.zero
	local startPosition = main.Position
	topbar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPosition = main.Position
		end
	end)
	local resizing = false
	local resizeStart = Vector2.zero
	local startSize = Vector2.zero
	resize.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			resizing = true
			resizeStart = input.Position
			startSize = main.AbsoluteSize
		end
	end)
	table.insert(self._connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
		elseif resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - resizeStart
			self.TargetSize = UDim2.fromOffset(
				math.clamp(startSize.X + delta.X, self.MinSize.X, self.MaxSize.X),
				math.clamp(startSize.Y + delta.Y, self.MinSize.Y, self.MaxSize.Y)
			)
			main.Size = self.TargetSize
		end
		if tooltip.Visible then
			local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
			tooltip.Position = UDim2.fromOffset(
				math.min(input.Position.X + 14, viewport.X - tooltip.AbsoluteSize.X - 8),
				math.min(input.Position.Y + 18, viewport.Y - tooltip.AbsoluteSize.Y - 8)
			)
		end
	end))
	table.insert(self._connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging or resizing then self:_scheduleSave() end
			dragging = false
			resizing = false
		end
	end))
	table.insert(self._connections, UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and UserInputService:GetFocusedTextBox() == nil and input.KeyCode == self.Hotkey then
			self:Toggle()
		end
	end))
	local conditionAccumulator = 0
	table.insert(self._connections, RunService.Heartbeat:Connect(function(delta)
		conditionAccumulator += delta
		if conditionAccumulator >= 0.25 then
			conditionAccumulator = 0
			for _, element in ipairs(self._conditions) do
				if element.Container.Parent then element:_refreshCondition() end
			end
		end
	end))
	if self.Mobile then
		local function updateMobileSize()
			local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600)
			self.TargetSize = UDim2.fromOffset(math.max(340, viewport.X - 20), math.max(320, viewport.Y - 20))
			main.Size = self.TargetSize
		end
		updateMobileSize()
		local camera = workspace.CurrentCamera
		if camera then
			table.insert(self._connections, camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateMobileSize))
		end
	end
	return self
end

Library.Themes = THEMES
Library.MemoryAdapter = MemoryAdapter

return Library
