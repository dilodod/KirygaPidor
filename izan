		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.Gotham,
		PlaceholderColor3 = self.App.Theme.MutedText,
		PlaceholderText = tostring(options.Placeholder or "Введите текст"),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0.55, 0, 0, 30),
		Text = "",
		TextColor3 = self.App.Theme.Text,
