			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			Position = UDim2.fromOffset(8, 48),
			ScrollBarImageColor3 = self.App.Theme.Border,
			ScrollBarThickness = 3,
			Size = UDim2.new(1, -16, 1, -56),
			ZIndex = 41,
		}) :: ScrollingFrame
		create("UIListLayout", {Padding = UDim.new(0, 4)}).Parent = list
		list.Parent = popup
		local optionButtons = {}
		for _, item in ipairs(element.Options) do
			local option = self.App:_button(tostring(item))
			option.Size = UDim2.new(1, -4, 0, 30)
			option.TextXAlignment = Enum.TextXAlignment.Left
			option.ZIndex = 42
			padding(0, 9, 0, 9).Parent = option
			option.Parent = list
			option.Activated:Connect(function()
				if multi then
					local nextValue = table.clone(element.Value or {})
					local index = table.find(nextValue, tostring(item))
					if index then table.remove(nextValue, index) else table.insert(nextValue, tostring(item)) end
					element:SetValue(nextValue)
				else
					element:SetValue(tostring(item))
					closePopup()
				end
			end)
			table.insert(optionButtons, {Button = option, Value = tostring(item)})
		end
		search:GetPropertyChangedSignal("Text"):Connect(function()
			local query = string.lower(search.Text)
			for _, record in ipairs(optionButtons) do
				record.Button.Visible = query == "" or string.find(string.lower(record.Value), query, 1, true) ~= nil
			end
		end)
		popup.Parent = self.App.ScreenGui
	end)
	element:SetValue(options.Default, true)
	element:_refreshCondition()
	return element
end

